    <string name="onb_welcome_title">Drugi pilot dla Bolt, Uber i FREENOW</string>
    <string name="onb_welcome_1">Każda oferta oceniona w mniej niż sekundę: za km i za godzinę, z dojazdem i powrotem.</string>
    <string name="onb_welcome_2">Odpowiadaj przyciskami na kierownicy — ręce zostają na kierownicy.</string>
    <string name="onb_welcome_3">Słabe oferty w trakcie kursu są po cichu ignorowane — wskaźnik akceptacji bezpieczny.</string>
    <string name="onb_start">Zaczynamy</string>
    <string name="onb_role_title">Co robi to urządzenie?</string>
    <string name="onb_role_hint">Kierowcy zwykle mają 2–3 telefony. Jedno urządzenie decyduje (kokpit), pozostałe czytają oferty.</string>
    <string name="onb_permissions_title">Uprawnienia</string>
    <string name="onb_permissions_hint">Każde uprawnienie wyjaśniamy przed prośbą. Możesz je zmienić w każdej chwili.</string>
    <string name="onb_done_title">Gotowe</string>
    <string name="onb_done_body">Otwórz Bolt, Uber lub FREENOW i rozpocznij zmianę. Oferty pojawią się tutaj i w aucie.</string>
    <string name="onb_finish">Otwórz kokpit</string>
    <string name="next">Dalej</string>
    <string name="back">Wstecz</string>
    <string name="skip_for_now">Pomiń na razie</string>
    <string name="grant">Zezwól</string>
    <string name="granted">Zezwolono</string>

    <string name="perm_accessibility_title">Czytanie kart zleceń</string>
    <string name="perm_accessibility_body">Taxi Commandos używa usługi ułatwień dostępu, aby czytać tekst ofert w Bolt, Uber i FREENOW (cena, dojazd, kurs, adresy) i — tylko gdy włączysz autoakceptację — klikać „Akceptuj” za Ciebie. Inne aplikacje nie są czytane. Tekst kart zostaje w telefonie; do raportów synchronizowane są tylko liczby.</string>
    <string name="perm_notifications_title">Natychmiastowe wykrywanie ofert</string>
    <string name="perm_notifications_body">Dostęp do powiadomień pozwala zareagować na „nowe zlecenie” ok. 1 s przed kartą. Patrzymy tylko na powiadomienia aplikacji kierowców.</string>
    <string name="perm_overlay_title">Werdykt na wierzchu</string>
    <string name="perm_overlay_body">Mały dymek nad kartą Bolt/Uber z werdyktem i trzema liczbami.</string>
    <string name="perm_post_notifications_title">Powiadomienie zmiany</string>
    <string name="perm_post_notifications_body">Potrzebne, by asystent działał całą zmianę i pokazywał alerty wskaźnika akceptacji.</string>
    <string name="perm_battery_title">Żeby oszczędzanie baterii nie wyłączało</string>
    <string name="perm_battery_body">Samsung i Xiaomi zatrzymują aplikacje w tle. Zezwól na nieograniczone użycie baterii.</string>
    <string name="perm_lite_note">To wersja z Google Play: czytanie kart i autoakceptacja są w pełnej wersji z taxicom.app.</string>

    <string name="role_both">Telefon z aplikacjami + decyzje</string>
    <string name="role_both_hint">Jeden telefon: czyta oferty i podejmuje decyzje.</string>
    <string name="role_capture">Czytnik</string>
    <string name="role_capture_hint">Tu działa Bolt/Uber/FREENOW i czyta oferty. Decyzje przychodzą z kokpitu.</string>
    <string name="role_cockpit">Kokpit</string>
    <string name="role_cockpit_hint">Pokazuje oferty ze wszystkich telefonów, przyciski kierownicy i głos.</string>
    <string name="role_viewer">Ekran</string>
    <string name="role_viewer_hint">Tablet lub drugi ekran: tylko pulpit i raporty.</string>

