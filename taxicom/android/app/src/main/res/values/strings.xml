    <!-- Onboarding -->
    <string name="onb_welcome_title">Your co-pilot for Bolt, Uber and FREENOW</string>
    <string name="onb_welcome_1">Every offer is scored in under a second: per km, per hour, with pickup and the way back.</string>
    <string name="onb_welcome_2">Answer with the steering-wheel buttons — hands stay on the wheel.</string>
    <string name="onb_welcome_3">Weak offers during a trip are ignored silently, so your acceptance rate stays safe.</string>
    <string name="onb_start">Get started</string>
    <string name="onb_role_title">What does this device do?</string>
    <string name="onb_role_hint">Most drivers use 2–3 phones. One device makes decisions (cockpit), the others read offers.</string>
    <string name="onb_permissions_title">Permissions</string>
    <string name="onb_permissions_hint">Each permission is explained before you grant it. You can change them anytime.</string>
    <string name="onb_done_title">Ready to roll</string>
    <string name="onb_done_body">Open Bolt, Uber or FREENOW and start your shift. Offers will appear here and in your car.</string>
    <string name="onb_finish">Open cockpit</string>
    <string name="next">Next</string>
    <string name="back">Back</string>
    <string name="skip_for_now">Skip for now</string>
    <string name="grant">Allow</string>
    <string name="granted">Allowed</string>

    <string name="perm_accessibility_title">Read order cards</string>
    <string name="perm_accessibility_body">Taxi Commandos uses the Accessibility service to read the text of order offers in Bolt, Uber and FREENOW (price, pickup, trip, addresses) and, only if you enable auto-accept, to tap \"Accept\" for you. It reads nothing in other apps. Card text stays on your phone; only numbers for reports are synced.</string>
    <string name="perm_notifications_title">Detect new offers instantly</string>
    <string name="perm_notifications_body">Notification access lets us react to the \"new order\" notification ~1 s before the card appears. We only look at notifications from driver apps.</string>
    <string name="perm_overlay_title">Show the verdict on top</string>
    <string name="perm_overlay_body">A small bubble over the Bolt/Uber card with the verdict and three numbers.</string>
    <string name="perm_post_notifications_title">Shift notification</string>
    <string name="perm_post_notifications_body">Required to keep the assistant running during the shift and to show acceptance-rate alerts.</string>
    <string name="perm_battery_title">Don\'t get killed by battery saver</string>
    <string name="perm_battery_body">Samsung and Xiaomi stop background apps. Allow unrestricted battery use for a reliable shift.</string>
    <string name="perm_lite_note">This is the Google Play edition: card reading and auto-accept are available in the full version from taxicom.app.</string>

